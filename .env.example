# =============================================================================
# .env のひな形。
#
# このファイルをコピーして .env を作り、実際の値を入れる。
#   cp .env.example .env
#
# .env は APP_ROOT 直下（= public/ の1つ上、ドキュメントルート外）に置く。
# 値を書いた .env は絶対にコミットしない（.gitignore で除外済み）。
# パーミッションは 600 にする。
# =============================================================================

# production の場合はデバッグ出力を一切行わない
APP_ENV=production

# -----------------------------------------------------------------------------
# データベース（Xserver）
#   DB_HOST は localhost 不可。サーバーパネルの「MySQL設定」に表示される
#   mysqlXXX.xserver.jp 形式のホスト名をそのまま入れる。
# -----------------------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=mysqlXXX.xserver.jp
DB_PORT=3306
DB_NAME=xxxxxxx_autobest
DB_USER=xxxxxxx_bot
DB_PASS=

# XserverのサーバーパネルでMySQLをまだ作れない場合の暫定運用。
# DB_DRIVER=sqlite にすると DB_PATH のSQLiteファイルを使う。
DB_PATH=storage/autobest.sqlite

# -----------------------------------------------------------------------------
# LINE Messaging API
#   LINE Developers > 対象チャネル > 「Messaging API設定」から取得。
#   チャネルアクセストークンは長期のもの（発行し直すと旧トークンは無効になる）。
# -----------------------------------------------------------------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF（フェーズ4で使用）。LINEログインチャネルのチャネルID。
LINE_LOGIN_CHANNEL_ID=
LIFF_ID_ASSESSMENT=
LIFF_ID_SEARCH=

# 問い合わせ通知を送るオーナーのLINEユーザーID（Uから始まる文字列）
OWNER_LINE_USER_ID=

# -----------------------------------------------------------------------------
# 店舗情報（bot の固定文言に使う）
# -----------------------------------------------------------------------------
SHOP_NAME=autobest.jp
SHOP_TEL=0120-000-000
SHOP_ADDRESS=
SHOP_HOURS=10:00〜19:00
SHOP_HOLIDAY=

# -----------------------------------------------------------------------------
# URL
# -----------------------------------------------------------------------------
BOT_BASE_URL=https://bot.autobest.jp
IMG_BASE_URL=https://img.autobest.jp
PRIVACY_POLICY_URL=https://autobest.jp/privacy

# 画像アップロードの保存先（img.autobest.jp のドキュメントルート実体パス）
IMG_UPLOAD_DIR=/home/xxxxxxx/autobest.jp/public_html/img/cars

# -----------------------------------------------------------------------------
# テスト用の値
#   tests/ がこの3つを前提にしている。開発環境ではそのまま残しておくこと
#   （消すと php tests/run.php が3件落ちるが、製品の不具合ではない）。
#   本番の .env では消してよい。
# -----------------------------------------------------------------------------
QUOTED_VALUE="quoted value"
# コメント行を読み飛ばせるかの確認に使う
AFTER_COMMENT=yes
