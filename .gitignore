# 認証情報。絶対にコミットしない
.env

# ログ・一時ファイル（ドキュメントルート外だがリポジトリにも入れない）
/storage/logs/*
!/storage/logs/.gitkeep
/storage/tmp/*
!/storage/tmp/.gitkeep

# 査定申込の写真（お客様の個人情報）。実体は絶対にコミットしない
/storage/assessments/*
!/storage/assessments/.gitkeep
!/storage/assessments/.htaccess
/storage/*.sqlite
/storage/*.sqlite-*

# キュー処理の多重起動防止用ロックファイル
*.lock
*.tar.gz

# アップロード画像の実体は img.autobest.jp 側に置く
/public/uploads/

# OS / エディタ
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# リッチメニュー画像の生成に使う道具（開発機でのみ使う。Xserverには不要）
/node_modules/
# 当たり判定の確認用に出す画像。登録には使わないのでコミットしない
/bin/richmenu/*-overlay.png
# 生成時にダウンロードするフォントの置き場
/storage/tmp/fonts/
